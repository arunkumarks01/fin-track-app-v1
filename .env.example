# FinTrack v2 — backend configuration. Copy to `.env` (repo root) and fill in.
# Every tunable lives here (ARCHITECTURE §2 law 7: nothing hardcoded). Loaded by backend/app/core/config.py.

# --- runtime ---
APP_ENV=dev                       # dev | test | prod
PAPER_MODE=true                   # the only allowed value until the Phase-10 gate passes
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- auth (mutating routes) --- generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_AUTH_TOKEN=change-me-to-a-random-token-at-least-32-chars

# --- database (TimescaleDB). Local dev reaches the VPS via:  ssh -N -L 5433:localhost:5432 fintrack-vps
DATABASE_URL=postgresql://fintrack_v2:CHANGE_ME@localhost:5433/fintrack_v2
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=900000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=600000

# Integration tests only. Must point at a database whose name ends in `_test` (enforced).
TEST_DATABASE_URL=postgresql://fintrack_v2:CHANGE_ME@localhost:5433/fintrack_v2_test

# --- timescale storage (Apache build: chunk sizing + in-process retention job) ---
OHLCV_CHUNK_INTERVAL_DAYS=30
TICKS_CHUNK_INTERVAL_HOURS=24
TICKS_HOT_DAYS=7                 # ticks older than this are exported to Parquet, verified, then dropped
TICKS_RETENTION_CRON=20 2 * * *        # IST crontab for the ticks drop_chunks job

# --- scheduler (max_instances=1 + coalesce are fixed by design, not tunable) ---
SCHEDULER_MISFIRE_GRACE_SECONDS=60

# --- in-memory cache ---
CACHE_MAX_ENTRIES=10000

# --- Kite Connect (Phase 1). Redirect URL in the Kite console: http://127.0.0.1:8000/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
# KITE_HISTORICAL_RPS=3          # Kite limit: 3 req/s historical
# KITE_DEFAULT_RPS=10            # Kite limit: 10 req/s other endpoints
# KITE_MAX_RETRIES=3
# KITE_RETRY_BACKOFF_SECONDS=1

# --- universe + ingestion (defaults shown)
# UNIVERSE_INDEX_SYMBOLS=["NSE:NIFTY 50","NSE:NIFTY BANK","NSE:NIFTY FIN SERVICE","NSE:NIFTY MID SELECT","BSE:SENSEX","BSE:BANKEX"]
# INGEST_DAILY_START=2015-01-01
# DAILY_BAR_FINAL_NEXT_DAY_IST=08:15:00
# DAILY_INGEST_CRON=30 8 * * mon-sat
# INTRADAY_FINAL_AFTER_IST=16:00:00
# JOB_HISTORY_SIZE=20

# --- validation + coverage gate (defaults shown)
# VALIDATION_LARGE_GAP_PCT=20
# VALIDATION_MISSING_WEEKDAYS_FLAG=3
# COVERAGE_MIN_CLEAN_DAILY_BARS=250
# COVERAGE_MIN_SYMBOL_PCT=95
# COVERAGE_INDEX_OLDEST_BY=2015-01-31
# COVERAGE_MAX_STALE_WEEKDAYS=3

# --- Charts (DEC-CHART) ---
CHART_MAX_BARS=5000                # max bars per /api/data/candles page (100..50000)

# --- Adjustment review list ---
# unexplained steps at least this size (fraction) are listed for review; smaller = refit noise, counted
ADJ_REVIEW_MIN_STEP=0.0025
# DEC-CORROB: an unlisted step NSE's prices prove is a split/bonus needs a clean ratio p/q, p,q <= this
# ADJ_CORROBORATE_MAX_TERM=10

# --- Intraday analysis window (DEC-2015) ---
# Phase 2+ intraday backtests/statistics start here by default; older 1m is stored + chartable (opt-in, badged)
# INTRADAY_ANALYSIS_START=2016-01-01

# --- Reference data from NSE's archive (slice 1e) ---
# NSE_MTO_BASE_URL=https://nsearchives.nseindia.com/archives/equities/mto
# NSE_PARTICIPANT_BASE_URL=https://nsearchives.nseindia.com/content/nsccl
# NSE_DEALS_BASE_URL=https://nsearchives.nseindia.com/content/equities
# REFERENCE_AFTER_DAILY=true
# participant OI files: largest accepted gap (contracts) between NSE's rows and its own TOTAL
# PARTICIPANT_TOTAL_TOLERANCE_CONTRACTS=2

# --- Publisher RSS and FRED (slice 1e) ---
# NEWS_FETCH_CRON=7,22,37,52 * * * *
# FRED_API_KEY=

# --- F&O history (slice 1f) ---
# FO_UDIFF_FROM=2024-01-02        # first date using NSE's UDiFF file format
# FO_DB_BUDGET_GB=35              # the load stops when the whole database reaches this size

# --- Live data (slice 1d) ---
# TICKS_CAPTURE_CRON="58 8 * * mon-fri"        # IST; capture window 09:00-16:00 (TICKS_CAPTURE_START / _END)
# TICKS_HOT_DAYS=7                          # (see above) days of ticks kept in the database before export
# TICKS_PARQUET_DIR=data/ticks_parquet     # where verified Parquet files are written
# CHAIN_CRON="*/5 9-15 * * mon-fri"            # option-chain snapshots; the job keeps to 09:15-15:30
# CHAIN_STOCK_COUNT=20                      # top stock underlyings by option turnover
# CHAIN_STOCK_OVERRIDE=[]                   # JSON list to use instead of the ranking

# --- Phase 2 research analytics ---
# ANALYTICS_PERIODS={"ema":[9,20,21,50,200],"rsi":14,"atr":14}
# ANALYTICS_WARMUP_BARS=800
# ANALYTICS_MAX_RESULT_BARS=500
# ANALYTICS_OPENING_RANGE_MINUTES=15
# Supply pricing assumptions in basis points, here or on an options analytics request.
# ANALYTICS_OPTION_RATE_BPS=
# ANALYTICS_OPTION_DIVIDEND_BPS=
# ANALYTICS_OPTION_VOL_CEILING=5.0
# ANALYTICS_OPTION_SNAPSHOT_MAX_AGE_SECONDS=900
# ANALYTICS_IV_TENOR_DAYS=30
# ANALYTICS_IV_HISTORY_CALENDAR_DAYS=365
# ANALYTICS_IV_MIN_OBSERVATIONS=20

# --- Phase 3 candidate research ---
# SHORTS_ENABLED=false
# SCORING={"rsi_low":30,"rsi_high":70,"min_calibration_observations":30}
# SCORING_NEWS_ENABLED=false
# SCORING_SCAN_ENABLED=false
# SCORING_SWING_MORNING_CRON="20 9 * * mon-fri"
# SCORING_SWING_CLOSE_CRON="40 15 * * mon-fri"
# SCORING_INTRADAY_CRON="0 16 * * mon-fri"

# --- Phase 4 paper research risk ---
# PAPER_SUBMODE=learning
# RISK_SIZING_MODE=fixed_risk
# RISK={"paper_capital_paisa":1000000000,"risk_per_trade_bps":100,"max_notional_bps":1000}

# --- Phase 5 paper replay assumptions ---
# PAPER={"slippage_bps":5,"volume_bps":50,"brokerage_ppm":300,"gst_bps":1800}
